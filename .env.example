# Spotify Developer Dashboard > your app > Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional: microphone device name fragment or numeric device index
# ECHO_INPUT_DEVICE=1

# Optional: local Whisper command model (small.en is the default)
# ECHO_STT_MODEL=small.en

# Optional: openWakeWord model for "Echo" (download from https://openwakeword.com/library/4929).
# Without this, Echo uses strict Vosk candidate detection plus local Whisper verification.
# ECHO_WAKE_MODEL_PATH=C:\\Users\\Lenovo\\AppData\\Local\\Echo\\models\\Echo_20260930_221231.onnx
# ECHO_WAKE_THRESHOLD=0.50
