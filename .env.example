# Spotify Developer Dashboard app credentials.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Extract the Vosk small English model into this directory.
VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15

# Optional settings
ECHO_TTS_ENABLED=true
ECHO_COMMAND_TIMEOUT=4.5
ECHO_LOG_LEVEL=INFO
