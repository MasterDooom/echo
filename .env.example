# Spotify Developer Dashboard > your app > Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Picovoice Console > AccessKey
PICOVOICE_ACCESS_KEY=

# Download your Windows custom wake-word model for the phrase "Echo" and save it here.
ECHO_KEYWORD_PATH=assets/echo_windows.ppn

# Optional: input-device name fragment or numeric device index
# ECHO_INPUT_DEVICE=
